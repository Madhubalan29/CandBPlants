# Public URL of the live site (used for canonical links, sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://candbplants.com

# Optional: the HTML-tag verification code from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase → Project Settings → API Keys. Both are safe to expose publicly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
